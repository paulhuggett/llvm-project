  %t19 = load volatile i16, i16* @v19

  ; Call an external function that can clobber caller-saved registers.
  call void @clobber()

  ; Use all loaded temps after the call so they're live across it.
  %s0  = add i16 %t0,  %t1
  %s1  = add i16 %t2,  %t3
  %s2  = add i16 %t4,  %t5
