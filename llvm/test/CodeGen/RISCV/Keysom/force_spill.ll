  %s7  = add i16 %t14, %t15
  %s8  = add i16 %t16, %t17
  %s9  = add i16 %t18, %t19

  %r0 = add i16 %s0, %s1
  %r1 = add i16 %s2, %s3
  %r2 = add i16 %s4, %s5
  %r3 = add i16 %s6, %s7
  %r4 = add i16 %s8, %s9

  %u0 = add i16 %r0, %r1
  %u1 = add i16 %r2, %r3
  %v  = add i16 %u0, %u1
  %res = add i16 %v, %r4

  ret i16 %res
